{
  "expo": {
    "name": "Nero Saúde",
    "slug": "nero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nero",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "br.com.nerosaude.app"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png",
        "backgroundColor": "#F3F0EA"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "br.com.nerosaude.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F3F0EA"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O NERO usa a câmera para fotografar laudos, receitas e exames que você quiser guardar em Meus Documentos.",
          "photosPermission": "O NERO acessa suas fotos para anexar laudos, receitas e exames em Meus Documentos.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#0F2D63",
          "defaultChannel": "lembretes"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
