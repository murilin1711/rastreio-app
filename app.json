{
  "expo": {
    "name": "Nero Saúde",
    "slug": "nero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nero",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "O NERO usa o Face ID para que só você veja suas informações de saúde neste aparelho."
      },
      "bundleIdentifier": "br.com.nerosaude.app",
      "usesAppleSignIn": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-mono.png",
        "backgroundColor": "#FFFFFF"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "br.com.nerosaude.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O NERO usa a câmera para fotografar laudos, receitas e exames que você quiser guardar em Meus Documentos.",
          "photosPermission": "O NERO acessa suas fotos para anexar laudos, receitas e exames em Meus Documentos.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      [
        "expo-notifications",
        {
          "color": "#0F2D63",
          "defaultChannel": "lembretes"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "organization": "nero-saude",
          "project": "react-native",
          "url": "https://de.sentry.io/"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.778333253878-btk37n764jlvaq39nilqdnf35tk86qf1"
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e30fea11-66fa-49b6-b3c5-a1e0cc60ff93"
      }
    },
    "owner": "murilorp1711",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e30fea11-66fa-49b6-b3c5-a1e0cc60ff93",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
