exports[`relatório de hábitos e bem-estar traz as três ressalvas 1`] = `
"<!DOCTYPE html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Relatório de hábitos e bem-estar</title><style>
@page { size: A4; margin: 12mm 13mm; }
* { box-sizing: border-box; }
body { font-family: -apple-system, Helvetica, Arial, sans-serif; color: #1D2E45; font-size: 9.5pt; line-height: 1.3; margin: 0; }
header { border-bottom: 2px solid #0f2d63; padding-bottom: 8px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
header h1 { font-size: 18pt; margin: 0 0 4px; color: #0f2d63; }
header .marca { font-size: 9pt; letter-spacing: 1px; color: #5B8DB8; font-weight: 700; }
header .meta { font-size: 9.5pt; color: #4A5C7A; }
header .qr { width: 96px; height: 96px; flex: none; }
header .qr svg { width: 96px; height: 96px; }
/* Seções longas podem quebrar entre linhas (menos página em branco); o título nunca fica sozinho no fim da página. */
section { margin-bottom: 8px; }
h2, h3 { break-after: avoid; page-break-after: avoid; }
tr, li { break-inside: avoid; page-break-inside: avoid; }
h2 { font-size: 11pt; color: #0f2d63; margin: 8px 0 3px; border-left: 4px solid #5B8DB8; padding-left: 8px; }
/* Abre a terceira parte do relatório por especialidade: marca a virada de foco para complemento. */
h2.complemento { font-size: 14pt; border-left: none; padding: 14px 0 0; margin-top: 26px; border-top: 2px solid #DCE2EE; color: #4A5C7A; page-break-before: always; }
p { margin: 3px 0; }
ul { margin: 3px 0; padding-left: 18px; }
table { width: 100%; border-collapse: collapse; font-size: 8pt; margin: 3px 0; }
th, td { text-align: left; padding: 1px 6px; border-bottom: 1px solid #DCE2EE; vertical-align: top; }
th { background: #E9EDF5; font-weight: 600; }
tbody tr:nth-child(even) td { background: #F5F7FB; }
.barras { margin: 6px 0; }
.barra { display: flex; align-items: center; gap: 8px; font-size: 9pt; margin: 2px 0; }
.barra .rotulo { width: 70px; color: #4A5C7A; }
.barra .trilho { flex: 1; height: 8px; background: #E9EDF5; border-radius: 4px; overflow: hidden; }
.barra .preenchido { display: block; height: 100%; background: #5B8DB8; }
.barra .valor { width: 60px; text-align: right; }
.chip { display: inline-block; border-radius: 12px; padding: 2px 10px; font-size: 9.5pt; font-weight: 600; }
.fontes { page-break-inside: auto; break-inside: auto; font-size: 7.5pt; line-height: 1.25; }
.fontes ol { margin: 4px 0; padding-left: 18px; columns: 2; column-gap: 18px; }
.fontes li { break-inside: avoid; page-break-inside: avoid; }
.fontes a { color: #0f2d63; word-break: break-all; }
footer { margin-top: 12px; border-top: 1px solid #DCE2EE; padding-top: 8px; font-size: 8.5pt; color: #4A5C7A; }
footer p { margin: 3px 0; }
/* Página 1: painel (D-067). Sem cor de bom ou ruim: só a caixa de atenção tem destaque. */
.painel { break-inside: auto; page-break-inside: auto; break-after: page; page-break-after: always; margin-bottom: 0; }
.painel header { margin-bottom: 8px; }
.painel .paciente { font-size: 13pt; margin: 0 0 2px; }
.painel h3 { font-size: 10.5pt; color: #0f2d63; margin: 0 0 4px; }
.atencao { border: 1.5px solid #b91c1c; background: #fee2e2; border-radius: 6px; padding: 5px 10px; margin-bottom: 8px; }
.atencao h2 { border-left: none; padding-left: 0; margin: 0 0 2px; font-size: 11pt; color: #b91c1c; }
.atencao ul { margin: 0; font-size: 9.5pt; }
.cartoes { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 8px; }
.cartao { border: 1px solid #DCE2EE; border-radius: 6px; padding: 4px 10px; break-inside: avoid; page-break-inside: avoid; }
.cartao .titulo { font-size: 8.5pt; color: #4A5C7A; }
.cartao .valor { font-size: 14pt; font-weight: 700; color: #0f2d63; line-height: 1.15; }
.cartao .unidade { font-size: 9pt; font-weight: 400; color: #4A5C7A; }
.cartao .tendencia { font-size: 12pt; margin-left: 4px; }
.cartao .det { font-size: 8.5pt; color: #4A5C7A; }
.grafico, .remedios, .prevencao { margin-bottom: 8px; break-inside: avoid; page-break-inside: avoid; }
.grafico svg { display: block; width: 100%; height: auto; }
.legenda { font-size: 8pt; color: #4A5C7A; }
.remedio { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; font-size: 9.5pt; padding: 2px 0; border-bottom: 1px solid #E9EDF5; }
.remedio .nome { flex: 0 0 150px; }
.remedio .doses { flex: 1; letter-spacing: 1px; color: #0f2d63; }
.remedio .conta { white-space: nowrap; }
.prevencao p, .prevencao ul { font-size: 9.5pt; }
.painel-rodape { font-size: 8.5pt; color: #4A5C7A; border-top: 1px solid #DCE2EE; padding-top: 6px; }
@media screen { body { max-width: 820px; margin: 0 auto; padding: 24px; } .painel { border-bottom: 2px solid #DCE2EE; padding-bottom: 8px; margin-bottom: 16px; } }
@media screen and (max-width: 640px) { .cartoes { grid-template-columns: 1fr; } .fontes ol { columns: 1; } header { flex-direction: column; } body { padding: 16px; } .remedio .nome { flex-basis: 100%; } th, td { padding: 1px 3px; overflow-wrap: anywhere; } }
</style></head><body>
<section class="painel"><header><div><div class="marca">NERO</div><h1>Relatório de hábitos e bem-estar</h1><p class="paciente"><strong>Ana Souza</strong>, 51 anos</p><div class="meta">Sexo ao nascer: feminino · Condições informadas: hipertensão, diabetes (DM2)<br>Tabagismo: ex-fumante · 20,0 maços-ano<br>Período das medidas: últimos 90 dias (20/06/2026 a 18/09/2026)<br>Gerado em 18/09/2026 10:30</div></div></header><div class="atencao"><h2>Para atenção nesta consulta</h2><ul><li>Intestino (colorretal): FIT positivo: colonoscopia indicada (aberta em 20/08/2026)</li></ul></div><div class="cartoes"><div class="cartao"><div class="titulo">Peso e IMC</div><div class="valor">82,0 <span class="unidade">kg</span><span class="tendencia" title="desceu em relação à medida anterior" aria-label="desceu em relação à medida anterior">↓</span></div><div class="det">15/09/2026 · IMC 28,4</div></div><div class="cartao"><div class="titulo">Circunferência abdominal</div><div class="valor">96 <span class="unidade">cm</span></div><div class="det">15/09/2026</div></div></div><p class="painel-rodape">Detalhes nas páginas seguintes. Dados registrados pelo paciente e organizados pelo NERO; não substituem a avaliação médica.</p></section>
<section><h2>Dados gerais</h2><ul><li>Ana Souza · 51 anos · sexo ao nascer: feminino</li><li>Condições informadas: hipertensão, diabetes (DM2)</li><li>Tabagismo: ex-fumante · 20,0 maços-ano</li></ul></section>
<section><h2>Evolução corporal</h2><ul><li>Peso atual 82,0 kg (15/09/2026) · IMC 28,4: Sobrepeso</li><li>Circunferência abdominal 96 cm (15/09/2026): aumentado · relação cintura/altura 0,56 (acima de 0,5)</li><li>Tendência do peso: redução (médias de 14 dias)</li></ul><table><thead><tr><th>Data</th><th>Peso (kg)</th><th>IMC</th><th>Cintura (cm)</th></tr></thead><tbody><tr><td>15/09/2026</td><td>82,0</td><td>28,4</td><td>96</td></tr><tr><td>30/08/2026</td><td>83,0</td><td>28,7</td><td>—</td></tr><tr><td>15/08/2026</td><td>84,0</td><td>29,1</td><td>—</td></tr></tbody></table><table><thead><tr><th>Data</th><th>Método</th><th>Gordura %</th><th>Massa muscular (kg)</th><th>Massa magra (kg)</th></tr></thead><tbody><tr><td>01/09/2026</td><td>bioimpedância</td><td>27,0</td><td>30,0</td><td>—</td></tr></tbody></table></section>
<section><h2>Alimentação</h2><p>1 refeições registradas no período. O diário não conta calorias nem classifica alimentos.</p><table><thead><tr><th>Semana de</th><th>Dias registrados</th><th>Café</th><th>Almoço</th><th>Jantar</th><th>Padrão</th></tr></thead><tbody><tr><td>31/08/2026</td><td>1 de 7</td><td>—</td><td>12:30</td><td>—</td><td>horários semelhantes</td></tr></tbody></table><table><thead><tr><th>Data e hora</th><th>Refeição</th><th>O que comeu</th><th>Quantidade</th><th>Observação</th></tr></thead><tbody><tr><td>01/09/2026 12:30</td><td>Almoço</td><td>arroz, feijão e frango</td><td>habitual</td><td>—</td></tr></tbody></table></section>
<section><h2>Ingestão de água</h2><p>Meta em uso: 2.450 ml por dia (sugerida pelo app, 35 ml/kg). Registro manual da água bebida, sem incluir a água dos alimentos, por isso não é comparável às referências de água total (EFSA, IOM). A média considera apenas os dias com registro: dia sem anotação não é dia sem beber.</p><table><thead><tr><th>Semana de</th><th>Dias registrados</th><th>Média por dia</th><th>Total da semana</th><th>Dias que bateram a meta</th></tr></thead><tbody><tr><td>14/09/2026</td><td>3</td><td>1.983 ml</td><td>5.950 ml</td><td>2 de 3</td></tr></tbody></table></section>
<section><h2>Atividade física</h2><p>Meta em uso: 150 min/semana de atividade moderada ou equivalente (sugerida OMS/MS) + fortalecimento em 2 dias.</p><table><thead><tr><th>Semana de</th><th>Minutos que contam</th><th>Total</th><th>Dias ativos</th><th>Fortalecimento (dias)</th></tr></thead><tbody><tr><td>14/09/2026</td><td>90 / 150</td><td>90 min</td><td>2</td><td>1</td></tr></tbody></table><table><thead><tr><th>Data e hora</th><th>Atividade</th><th>Duração</th><th>Intensidade</th><th>Distância / FC</th></tr></thead><tbody><tr><td>14/09/2026 07:00</td><td>Caminhada</td><td>40 min</td><td>moderada</td><td>3,2 km</td></tr><tr><td>16/09/2026 18:00</td><td>Musculação</td><td>50 min</td><td>moderada</td><td>—</td></tr></tbody></table></section>
<section><h2>Sono</h2><p>Referência para adultos: 7h00 ou mais por noite (AASM/SRS 2015). Registros manuais; sem avaliação de insônia ou apneia.</p><table><thead><tr><th>Semana até</th><th>Noites</th><th>Média</th><th>Dormir</th><th>Acordar</th></tr></thead><tbody><tr><td>20/09/2026</td><td>1</td><td>6h40</td><td>23:40</td><td>06:20</td></tr></tbody></table><table><thead><tr><th>Noite (acordou)</th><th>Dormiu</th><th>Acordou</th><th>Duração</th><th>Qualidade</th></tr></thead><tbody><tr><td>16/09/2026</td><td>23:40</td><td>06:20</td><td>6h40</td><td>4/5</td></tr></tbody></table></section>
<section><h2>Check-ins semanais</h2><p>Respostas de 0 a 10 dadas pelo paciente sobre a semana. Não é instrumento diagnóstico.</p><table><thead><tr><th>Semana de</th><th>Disposição</th><th>Alimentação</th><th>Atividade</th><th>Sono</th><th>Estresse</th><th>Energia</th><th>Bem-estar</th><th>Observação</th></tr></thead><tbody><tr><td>07/09/2026</td><td>7</td><td>6</td><td>5</td><td>6</td><td>4</td><td>7</td><td>7</td><td>semana corrida</td></tr></tbody></table><table><thead><tr><th>Mês</th><th>Energia</th><th>Estresse</th><th>Bem-estar</th><th>Check-ins</th></tr></thead><tbody><tr><td>2026-09</td><td>7</td><td>4</td><td>7</td><td>1</td></tr></tbody></table></section>
<section><h2>Documentos anexados no período</h2><ul><li>Laudo mamografia · Laudo de exame · 10/05/2026</li></ul></section>
<section><h2>Pendências abertas</h2><p class="chip" style="background:#ffedd5;color:#c2410c">Intestino (colorretal) · desde 20/08/2026: FIT positivo: colonoscopia indicada</p></section>
<section class="fontes"><h2>Fontes</h2><ol><li>Diretrizes Brasileiras de Obesidade, 4ª ed. ABESO, 2016. <a href="https://abeso.org.br/wp-content/uploads/2019/12/Diretrizes-Download-Diretrizes-Brasileiras-de-Obesidade-2016.pdf">https://abeso.org.br/wp-content/uploads/2019/12/Diretrizes-Download-Diretrizes-Brasileiras-de-Obesidade-2016.pdf</a></li><li>Diretriz Brasileira de Tratamento Farmacológico da Obesidade. ABESO, 2026. <a href="https://abeso.org.br/wp-content/uploads/2026/03/Diretrizes-ABESO_completo_20260320.pdf">https://abeso.org.br/wp-content/uploads/2026/03/Diretrizes-ABESO_completo_20260320.pdf</a></li><li>Waist circumference and waist–hip ratio: report of a WHO expert consultation. Organização Mundial da Saúde, 2011. <a href="https://iris.who.int/handle/10665/44583">https://iris.who.int/handle/10665/44583</a></li><li>Obesidade Controlada (e-book). ABESO e SBEM, 2023. <a href="https://abeso.org.br/wp-content/uploads/2023/12/Ebook_Obesidade_Controlada.pdf">https://abeso.org.br/wp-content/uploads/2023/12/Ebook_Obesidade_Controlada.pdf</a></li><li>Diretriz Brasileira para o Manejo da Obesidade e Prevenção de Doença Cardiovascular. ABESO, SBD, SBEM, SBC e ABS · Arq Bras Cardiol, 2025. <a href="https://doi.org/10.36660/abc.20250621">https://doi.org/10.36660/abc.20250621</a></li><li>Scientific Opinion on Dietary Reference Values for water. EFSA Journal, 2010. <a href="https://doi.org/10.2903/j.efsa.2010.1459">https://doi.org/10.2903/j.efsa.2010.1459</a></li><li>Dietary Reference Intakes for Water, Potassium, Sodium, Chloride, and Sulfate. Institute of Medicine (National Academies), 2005. <a href="https://nap.nationalacademies.org/read/10925">https://nap.nationalacademies.org/read/10925</a></li><li>Practical guideline: Clinical nutrition and hydration in geriatrics. ESPEN, 2022. <a href="https://www.espen.org/files/ESPEN-Guidelines/ESPEN_practical_guideline_Clinical_nutrition_and_hydration_in_geriatrics.pdf">https://www.espen.org/files/ESPEN-Guidelines/ESPEN_practical_guideline_Clinical_nutrition_and_hydration_in_geriatrics.pdf</a></li><li>WHO guidelines on physical activity and sedentary behaviour. Organização Mundial da Saúde, 2020. <a href="https://www.who.int/publications/i/item/9789240015128">https://www.who.int/publications/i/item/9789240015128</a></li><li>Guia de Atividade Física para a População Brasileira. Ministério da Saúde, 2021. <a href="https://www.gov.br/saude/pt-br/centrais-de-conteudo/publicacoes/guias-e-manuais/2021/guia-de-atividade-fisica-para-a-populacao-brasileira.pdf/view">https://www.gov.br/saude/pt-br/centrais-de-conteudo/publicacoes/guias-e-manuais/2021/guia-de-atividade-fisica-para-a-populacao-brasileira.pdf/view</a></li><li>Recommended amount of sleep for a healthy adult (Watson NF et al.). AASM e SRS · J Clin Sleep Med, 2015. <a href="https://doi.org/10.5664/jcsm.4758">https://doi.org/10.5664/jcsm.4758</a></li></ol></section>
<footer><p>Este relatório organiza suas aferições domiciliares e não substitui a interpretação realizada pelo seu médico.</p><p>As informações apresentadas foram registradas pelo usuário e organizadas pelo NERO para facilitar o acompanhamento com seu profissional de saúde. O relatório não substitui avaliação médica.</p><p>Registros de hábitos, alimentação e sono são autorrelatados.</p><p>Gerado pelo NERO em 18/09/2026 10:30 · dados registrados pelo paciente.</p><p>Criado por Murilo Roiz Póvoa e Dra. Denise Padilha (CRM/AL 12430).</p></footer>
</body></html>"
`;

